# Which LLM parses song HTML: "claude" (paid, default) or "gemini" (has a free tier —
# see README.md for the data-usage tradeoff on the free tier before using it in production)
LLM_PROVIDER=claude

# Anthropic API (required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Google Gemini API (required if LLM_PROVIDER=gemini) — get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/hopamchuan

# Songs are per-account (see /signup on the web app). Local scripts
# (npm run crawl, npm run viewer) need to know which account to read/write —
# sign up once on the web app, then put that username here.
CRAWL_USERNAME=

# Public viewer session signing (Vercel deployment) — any random string
SESSION_SECRET=

# Optional: HTTP Basic Auth for the local viewer only (npm run viewer).
# Unrelated to the /signup accounts above — leave unset for no local auth.
VIEWER_USERNAME=
VIEWER_PASSWORD=

# Crawler behavior
CRAWL_DELAY_MS=1500
CRAWL_ID_BATCH_SIZE=200
CRAWL_MAX_CONSECUTIVE_MISSES=40
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3
